@echo off
chcp 65001 > nul
title GoldenERP - رادار التعاقدات الحكومية المصرية
color 0b

:MENU
cls
echo ================================================================
echo    GoldenERP - الزاحف الذكي لبوابة التعاقدات الحكومية المصرية
echo ================================================================
echo.
echo   [1] فحص وسحب أحدث المناقصات الآن (فحص فوري 15 ثانية)
echo   [2] تشغيل خادم الربط مع زر الموقع (Local Bridge لربط الزر بـ ahdahd.eu)
echo   [3] خروج
echo.
echo ================================================================
set /p choice="اختر رقم العملية (1 أو 2 أو 3): "

if "%choice%"=="1" goto INSTANT_SCAN
if "%choice%"=="2" goto RUN_BRIDGE
if "%choice%"=="3" goto EXIT

echo اختيار غير صحيح!
timeout /t 2 > nul
goto MENU

:INSTANT_SCAN
cls
echo ================================================================
echo [*] جاري فحص وسحب أحدث المناقصات الرسمية وكراسات الشروط من مصر...
echo ================================================================
echo.
node "%~dp0scripts\cloud-crawler.mjs"
echo.
echo ================================================================
echo [*] اكتمل فحص وتحديث رادار GoldenERP بنجاح تام!
echo ================================================================
echo.
pause
goto MENU

:RUN_BRIDGE
cls
echo ================================================================
echo [*] جاري تشغيل خادم الربط المحلي (GoldenERP Local Bridge)...
echo [*] يمكنك الآن الضغط على زر "تشغيل فحص الرادار" من داخل موقع ahdahd.eu
echo [*] ليتم الفحص تلقائياً عبر جهازك في مصر!
echo ================================================================
echo.
node "%~dp0scripts\radar-local-bridge.mjs"
pause
goto MENU

:EXIT
exit
