# Database
DATABASE_URL="mysql://root:password@localhost:3306/goldenerp_dev"

# JWT
JWT_SECRET="goldenerp-jwt-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="goldenerp-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_MANAGER_CHAT_ID=""
TELEGRAM_DEPUTY_CHAT_ID=""

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# App
APP_PORT=4000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# Security
ACCOUNT_LOCK_ATTEMPTS=3
AFTER_HOURS_START=20
AFTER_HOURS_END=6
